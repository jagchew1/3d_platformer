[application]
config/name="Skybound Steps"
run/main_scene="res://mobile/main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.25, 0.58, 0.82, 1)

[audio]
driver/enable_input=false

[input]
jump={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32)]}
restart={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":82)]}

